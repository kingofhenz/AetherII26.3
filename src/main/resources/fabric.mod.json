{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["bconlon", "Builderdog", "bagu_chan", "Blodhgarm", "Drullkus", "Hugo Payn", "Jaryt", "Jasper", "Katie 'Oz' Payn", "Mercedes", "Raptor", "reetamb", "RENREN", "sunsette"],
  "contributors": [
    "${mod_credits}"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "https://github.com/The-Aether-Team/The-Aether-II",
    "issues": "${mod_tracker}"
  },
  "license": "${mod_license}",
  "icon": "${mod_id}.png",
