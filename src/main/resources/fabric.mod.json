      "com.aetherteam.aetherii.AetherII"
    ],
    "client": [
      "com.aetherteam.aetherii.client.AetherIIClient"
    ],
    "fabric-datagen": [
      "com.aetherteam.aetherii.data.AetherIIData"
    ],
